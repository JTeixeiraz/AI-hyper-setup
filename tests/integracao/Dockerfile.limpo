FROM ubuntu:24.04
RUN apt-get update && apt-get install -y curl ca-certificates git tar \
    && rm -rf /var/lib/apt/lists/*
# Um agente falso no PATH: o teste mede o comportamento do instalador,
# nao a presenca do Claude Code de verdade.
RUN printf '#!/bin/sh\necho "claude 1.0"\n' > /usr/local/bin/claude \
    && chmod +x /usr/local/bin/claude
WORKDIR /repo
COPY . .
